{
  "name": "hedgehog-docs",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next --turbopack",
    "prebuild": "cd .. && PYTHONPATH=src uv run python scripts/generate_api_docs.py --output docs/content/api/index.mdx",
    "build": "next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "start": "next start"
  },
  "dependencies": {
    "next": "^16.1.7",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.3.2",
      "lodash-es": "4.17.23",
      "minimatch": "10.2.3"
    }
  }
}
